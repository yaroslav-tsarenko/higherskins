# ============================================================
# Database — Prisma Postgres
# ============================================================

# Prisma Postgres protocol URL (used by Prisma CLI)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."

# Direct PostgreSQL connection (used by app runtime and seed)
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ============================================================
# Auth
# ============================================================
JWT_SECRET="change-this-to-a-random-secret-in-production"

# ============================================================
# App Config
# ============================================================
NEXT_PUBLIC_SITE_URL="https://higherskins.com"

# Public base URL of this deployment. Steam OpenID uses it to build the
# realm and return_to callback, so it MUST match the origin users hit
# (no trailing slash). Locally use http://localhost:9997; in production set
# your real domain, e.g. https://higherskins.com. On Vercel, VERCEL_URL is
# used automatically as a fallback if these are unset.
APP_URL="http://localhost:9997"
NEXT_PUBLIC_APP_URL="http://localhost:9997"

# ============================================================
# Steam
# ============================================================
# Steam Web API key from https://steamcommunity.com/dev/apikey — used to fetch
# player profile summaries (persona name, avatar) after OpenID sign-in. Sign-in
# still works without it, but profiles degrade to a bare SteamID64.
STEAM_API_KEY="your-steam-web-api-key"

# ============================================================
# Cloudflare R2 — Image CDN Storage
# ============================================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# ============================================================
# Social Media
# ============================================================
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/nivro.uk/"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/higherskins-uk/"

# ============================================================
# Resend — transactional emails
# ============================================================
RESEND_API_KEY="re_xxxxx"
RESEND_FROM_EMAIL="Higherskins <noreply@higherskins.com>"
RESEND_REPLY_TO="info@higherskins.com"
